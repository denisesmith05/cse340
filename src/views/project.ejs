<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>

    <p><%= project.description %></p>
    <p>Date: <%= new Date(project.date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    }) %></p>
    <p>Location: <%= project.location %></p>
    <p>
        Partner organization:
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <% if (isLoggedIn) { %>
        <% if (isVolunteer) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/volunteer/remove" method="post">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="post">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>
    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
        </p>
    <% } %>
    <h2>Categories</h2>
    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/project/<%= project.project_id %>/assign-categories">
                Edit Categories
            </a>
        </p>
    <% } %>
    <div class="category-tags">
        <% categories.forEach(category => { %>
            <a class="category-tag" href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
        <% }) %>
    </div>
</main>
<%- include('partials/footer') %>