<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <% Object.values(errors).forEach(error => { %>
            <p class="error"><%= error.msg %></p>
        <% }); %>

        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= formData.title ?? project.title %>"
                maxlength="150"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="500"
                required
            ><%= formData.description ?? project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= formData.location ?? project.location %>"
                maxlength="255"
                required
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= formData.date ?? new Date(project.date).toISOString().slice(0, 10) %>"
                required
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">Select an organization</option>
                <% organizations.forEach(organization => { %>
                    <option
                        value="<%= organization.organization_id %>"
                        <%= String(formData.organizationId ?? project.organization_id) === String(organization.organization_id) ? 'selected' : '' %>
                    ><%= organization.name %></option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>