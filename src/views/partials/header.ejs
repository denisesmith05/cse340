    <script> 
            const hamburger = document.querySelector("#menu"); 
            const navLinks = document.querySelector(".nav-links"); 
            hamburger.addEventListener("click", () => { navLinks.classList.toggle("show"); 
            hamburger.classList.toggle("show"); }); 
    </script>
</body>