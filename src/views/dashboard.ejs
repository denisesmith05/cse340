<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    <% if (isAdmin) { %>
        <p><a href="/users">View registered users</a></p>
    <% } %>
    <h2>Projects I'm Volunteering For</h2>
    <% if (volunteerProjects.length > 0) { %>
        <ul>
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    - <%= new Date(project.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    }) %>
                    <form action="/project/<%= project.project_id %>/volunteer/remove" method="post">
                        <input type="hidden" name="returnTo" value="dashboard">
                        <button type="submit">Remove me</button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>You have not signed up to volunteer for any projects yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>